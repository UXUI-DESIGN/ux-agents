// UXA API 서버 (Cloudflare Worker)
// OpenAI 키는 여기 쓰지 않는다. `npx wrangler secret put OPENAI_API_KEY`로 비밀값에만 저장한다.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uxa-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // 회원·세션·가입 시도 기록 (테이블은 migrations/ 참고)
  "d1_databases": [
    { "binding": "DB", "database_name": "uxa-db", "database_id": "ba08509d-65b8-4e5c-837f-e2189b18fe57" }
  ],
  "vars": {
    // 이 Worker를 부를 수 있는 사이트 주소 (쉼표로 구분)
    "ALLOWED_ORIGINS": "https://ux-agents.pages.dev,http://localhost:5173",
    "OPENAI_MODEL": "gpt-6-luna",
    // 페르소나 프로필 사진 생성 모델 (Images API)
    "OPENAI_IMAGE_MODEL": "gpt-image-1",
    // 페르소나 채팅 근거 노트 임베딩 모델 (rag_chunks 는 1536차원 기준)
    "OPENAI_EMBED_MODEL": "text-embedding-3-small"
  }
}
