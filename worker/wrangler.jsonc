// UXA API 서버 (Cloudflare Worker)
// OpenAI 키는 여기 쓰지 않는다. `npx wrangler secret put OPENAI_API_KEY`로 비밀값에만 저장한다.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uxa-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // 회원·세션·가입 시도 기록 (테이블은 migrations/ 참고)
  "d1_databases": [
    { "binding": "DB", "database_name": "uxa-db", "database_id": "ba08509d-65b8-4e5c-837f-e2189b18fe57" }
  ],
  // 시나리오 보드: 컷 1개 = 메시지 1개 (만들기: npx wrangler queues create uxa-board-cuts)
  //   max_batch_size 1 → 컷마다 따로 처리, max_retries 3 → 자동 재시도 2번 + 처리 중 끊긴 경우 여유 1번 (재시도 판단은 boards.js)
  "queues": {
    "producers": [{ "binding": "CUT_QUEUE", "queue": "uxa-board-cuts" }],
    "consumers": [{ "queue": "uxa-board-cuts", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 3, "max_concurrency": 4 }]
  },
  "vars": {
    // 이 Worker를 부를 수 있는 사이트 주소 (쉼표로 구분)
    "ALLOWED_ORIGINS": "https://ux-agents.pages.dev,http://localhost:5173",
    "OPENAI_MODEL": "gpt-6-luna",
    // 페르소나 프로필 사진 생성 모델 (Images API)
    "OPENAI_IMAGE_MODEL": "gpt-image-2.5-flare",
    // 페르소나 채팅 근거 노트 임베딩 모델 (rag_chunks 는 1536차원 기준)
    "OPENAI_EMBED_MODEL": "text-embedding-3-small"
  }
}
